{
  "paths": {
    "workspace_dir": "../training_data/action_pipeline_aihub",
    "workspace_dir_env": "DETECTWARNING_WORKSPACE_DIR"
  },
  "dataset_source": "aihub_shell",
  "aihub_shell": {
    "path": "aihubshell",
    "mode": "d",
    "datasetkey": null,
    "datapackagekey": null,
    "filekey": null,
    "api_key_env": "AIHUB_API_KEY",
    "api_key": "",
    "note": "datasetkey는 AIHub 데이터셋 키이고, 대시보드에 입력하는 filekey는 분할 ZIP 목록의 key 값입니다."
  },
  "dataset": {
    "target_labels": [
      "normal",
      "violence",
      "collapse",
      "abduction",
      "loitering"
    ],
    "label_mapping": {
      "일반행동": "normal",
      "normal": "normal",
      "폭행": "violence",
      "폭행(assault)": "violence",
      "assault": "violence",
      "fight": "violence",
      "fighting": "violence",
      "violence": "violence",
      "싸움": "violence",
      "싸움(fight)": "violence",
      "데이트폭력 및 폭행": "violence",
      "데이트폭력 및 추행": "violence",
      "데이트폭력및추행": "violence",
      "데이트폭력및추행(datefight)": "violence",
      "datefight": "violence",
      "datingviolence": "violence",
      "dating_violence": "violence",
      "실신": "collapse",
      "실신(swoon)": "collapse",
      "swoon": "collapse",
      "fainting": "collapse",
      "collapse": "collapse",
      "납치": "abduction",
      "납치(kidnap)": "abduction",
      "kidnap": "abduction",
      "kidnapping": "abduction",
      "abduction": "abduction",
      "배회": "loitering",
      "배회(wander)": "loitering",
      "loitering": "loitering",
      "wander": "loitering",
      "wandering": "loitering"
    },
    "excluded_source_labels": [
      "주취행동",
      "주취행동(drunken)",
      "drunken",
      "투기",
      "투기(dump)",
      "dump",
      "절도",
      "절도(burglary)",
      "burglary",
      "침입",
      "침입(trespass)",
      "trespass",
      "강도",
      "강도(robbery)",
      "robbery",
      "기물파손",
      "기물파손(vandalism)",
      "vandalism"
    ],
    "video_extensions": [
      ".mp4",
      ".avi",
      ".mov",
      ".mkv",
      ".wmv"
    ]
  },
  "split": {
    "train_ratio": 0.7,
    "val_ratio": 0.15,
    "test_ratio": 0.15,
    "seed": 42
  },
  "preprocess": {
    "device": "cuda:0",
    "person_score_threshold": 0.25,
    "person_imgsz": 640,
    "detector_batch_size": 24,
    "video_prefetch_workers": 2,
    "compress_prepared_pose": false,
    "sequence_length": 48,
    "max_frames_to_scan": 160,
    "min_frames_with_person": 4,
    "fallback_min_frames_with_person": 1,
    "max_missing_frames_ratio": 0.98,
    "min_total_keypoints": 1,
    "allow_partial_pose": true,
    "allow_padding": true,
    "allow_rejected_pose_fallback": true,
    "fallback_min_keypoints": 3,
    "fallback_min_detection_confidence": 0.15,
    "fallback_min_person_score": 20,
    "skip_invalid_labels": true,
    "strict_data_validation": false
  },
  "training": {
    "device": "cuda",
    "amp": true,
    "amp_dtype": "auto",
    "compile_model": true,
    "compile_backend": "auto",
    "epochs": 20,
    "early_stopping_patience": 5,
    "early_stopping_min_delta": 0.001,
    "imbalance_warn_min_samples": 8,
    "imbalance_warn_ratio": 5.0,
    "batch_size": 48,
    "eval_batch_size": 96,
    "dataset_cache_size": 2048,
    "learning_rate": 0.001,
    "weight_decay": 0.001,
    "hidden_dim": 128,
    "num_layers": 2,
    "dropout": 0.2,
    "label_smoothing": 0.05,
    "loss": "cross_entropy",
    "focal_gamma": 2.0,
    "class_weight": "balanced",
    "balanced_sampler": "auto",
    "grad_clip_norm": 1.0,
    "seed": 42,
    "deterministic": false,
    "num_workers": "auto",
    "pin_memory": "auto",
    "prefetch_factor": 4,
    "persistent_workers": true
  },
  "continual_learning": {
    "enabled": true,
    "resume_from_best": true,
    "cleanup_raw_after_job": true
  },
  "dashboard": {
    "allowed_origins": []
  },
  "pages_sync": {
    "enabled": true,
    "pages_dir": "C:/Users/Administrator/Documents/GitHub/detectWarning-pages",
    "project_name": "detectWarning",
    "report_title": "행동 학습 결과 리포트",
    "report_url": "",
    "live_url": "",
    "live_url_env": "DETECTWARNING_LIVE_URL",
    "redirect_delay_seconds": 3,
    "git_auto_push": true,
    "git_commit_prefix": "Update dashboard"
  }
}
