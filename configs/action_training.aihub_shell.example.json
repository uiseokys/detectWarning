{
  "paths": {
    "workspace_dir": "../training_data/action_pipeline_aihub"
  },
  "dataset_source": "aihub_shell",
  "aihub_shell": {
    "path": "aihubshell",
    "mode": "d",
    "datasetkey": null,
    "datapackagekey": null,
    "filekey": null,
    "api_key_env": "AIHUB_API_KEY",
    "api_key": "",
    "note": "datasetkey는 AIHub 데이터셋 키이고, 대시보드에 입력하는 filekey는 분할 ZIP 목록의 key 값입니다."
  },
  "dataset": {
    "target_labels": [
      "normal",
      "violence",
      "collapse",
      "abduction",
      "loitering"
    ],
    "label_mapping": {
      "일반행동": "normal",
      "normal": "normal",
      "폭행": "violence",
      "assault": "violence",
      "fight": "violence",
      "fighting": "violence",
      "violence": "violence",
      "싸움": "violence",
      "데이트폭력 및 폭행": "violence",
      "datingviolence": "violence",
      "dating_violence": "violence",
      "실신": "collapse",
      "fainting": "collapse",
      "collapse": "collapse",
      "납치": "abduction",
      "kidnap": "abduction",
      "kidnapping": "abduction",
      "abduction": "abduction",
      "배회": "loitering",
      "배회(wander)": "loitering",
      "loitering": "loitering",
      "wander": "loitering",
      "wandering": "loitering"
    },
    "video_extensions": [
      ".mp4",
      ".avi",
      ".mov",
      ".mkv",
      ".wmv"
    ]
  },
  "split": {
    "train_ratio": 0.7,
    "val_ratio": 0.15,
    "test_ratio": 0.15,
    "seed": 42
  },
  "preprocess": {
    "device": "cuda:0",
    "person_score_threshold": 0.25,
    "person_imgsz": 640,
    "detector_batch_size": 16,
    "compress_prepared_pose": false,
    "sequence_length": 48,
    "max_frames_to_scan": 160,
    "min_frames_with_person": 4
  },
  "training": {
    "device": "cuda",
    "amp": true,
    "epochs": 20,
    "batch_size": 32,
    "learning_rate": 0.001,
    "hidden_dim": 128,
    "num_layers": 2,
    "dropout": 0.2,
    "num_workers": "auto",
    "prefetch_factor": 4,
    "persistent_workers": true
  },
  "continual_learning": {
    "enabled": true,
    "resume_from_best": true,
    "cleanup_raw_after_job": true
  },
  "pages_sync": {
    "enabled": true,
    "pages_dir": "C:/Users/Administrator/Documents/GitHub/detectWarning-pages",
    "project_name": "detectWarning",
    "report_title": "행동 학습 결과 리포트",
    "live_url": "",
    "live_url_env": "DETECTWARNING_LIVE_URL",
    "redirect_delay_seconds": 3,
    "git_auto_push": true,
    "git_commit_prefix": "Update dashboard"
  }
}
