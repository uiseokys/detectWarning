{
  "paths": {
    "workspace_dir": "../training_data/action_pipeline"
  },
  "api": {
    "list_url": "https://your-dataset-api.example.com/videos",
    "items_path": "results",
    "next_path": "next",
    "page_param": "page",
    "page_start": 1,
    "max_pages": 0,
    "timeout_seconds": 120.0,
    "auth_header": "Authorization",
    "auth_token_env": "ACTION_DATASET_API_TOKEN",
    "headers": {},
    "params": {
      "page_size": 100
    },
    "fields": {
      "id": "id",
      "label": "label",
      "filename": "file_name",
      "download_url": "download_url"
    }
  },
  "dataset": {
    "target_labels": [
      "normal",
      "violence",
      "collapse",
      "abduction",
      "loitering"
    ],
    "label_mapping": {
      "일반행동": "normal",
      "폭행": "violence",
      "싸움": "violence",
      "데이트폭력 및 폭행": "violence",
      "실신": "collapse",
      "납치": "abduction",
      "배회": "loitering"
    },
    "max_items_per_class": 0
  },
  "split": {
    "train_ratio": 0.7,
    "val_ratio": 0.15,
    "test_ratio": 0.15,
    "seed": 42
  },
  "preprocess": {
    "device": "cuda:0",
    "person_score_threshold": 0.25,
    "person_imgsz": 640,
    "sequence_length": 48,
    "max_frames_to_scan": 160,
    "min_frames_with_person": 4
  },
  "training": {
    "device": "cuda",
    "epochs": 20,
    "batch_size": 16,
    "learning_rate": 0.001,
    "hidden_dim": 128,
    "num_layers": 2,
    "dropout": 0.2,
    "num_workers": 0
  }
}
