{
  "paths": {
    "workspace_dir": "../training_data/action_pipeline",
    "workspace_dir_env": "DETECTWARNING_WORKSPACE_DIR"
  },
  "dataset_source": "json_api",
  "api": {
    "list_url": "https://your-dataset-api.example.com/videos",
    "items_path": "results",
    "next_path": "next",
    "page_param": "page",
    "page_start": 1,
    "max_pages": 0,
    "timeout_seconds": 120.0,
    "auth_required": false,
    "auth_header": "Authorization",
    "auth_token_env": "",
    "headers": {},
    "params": {
      "page_size": 100
    },
    "fields": {
      "id": "id",
      "label": "label",
      "filename": "file_name",
      "download_url": "download_url"
    }
  },
  "dataset": {
    "target_labels": [
      "normal",
      "violence",
      "collapse",
      "abduction",
      "intrusion_crime",
      "loitering",
      "vandalism"
    ],
    "label_mapping": {
      "일반행동": "normal",
      "normal": "normal",
      "폭행": "violence",
      "assault": "violence",
      "fight": "violence",
      "fighting": "violence",
      "violence": "violence",
      "싸움": "violence",
      "데이트폭력 및 폭행": "violence",
      "데이트폭력 및 추행": "violence",
      "datefight": "violence",
      "datingviolence": "violence",
      "dating_violence": "violence",
      "실신": "collapse",
      "fainting": "collapse",
      "collapse": "collapse",
      "납치": "abduction",
      "kidnap": "abduction",
      "kidnapping": "abduction",
      "abduction": "abduction",
      "절도": "intrusion_crime",
      "burglary": "intrusion_crime",
      "침입": "intrusion_crime",
      "trespass": "intrusion_crime",
      "강도": "intrusion_crime",
      "robbery": "intrusion_crime",
      "배회": "loitering",
      "배회(wander)": "loitering",
      "loitering": "loitering",
      "wander": "loitering",
      "wandering": "loitering",
      "기물파손": "vandalism",
      "vandalism": "vandalism"
    },
    "video_extensions": [
      ".mp4",
      ".avi",
      ".mov",
      ".mkv",
      ".wmv"
    ],
    "max_items_per_class": 0
  },
  "split": {
    "train_ratio": 0.7,
    "val_ratio": 0.15,
    "test_ratio": 0.15,
    "seed": 42
  },
  "preprocess": {
    "device": "cuda:0",
    "person_score_threshold": 0.25,
    "person_imgsz": 640,
    "detector_batch_size": 24,
    "video_prefetch_workers": 2,
    "compress_prepared_pose": false,
    "sequence_length": 48,
    "max_frames_to_scan": 160,
    "min_frames_with_person": 4
  },
  "training": {
    "device": "cuda",
    "amp": true,
    "amp_dtype": "auto",
    "compile_model": true,
    "compile_backend": "auto",
    "epochs": 20,
    "early_stopping_patience": 5,
    "early_stopping_min_delta": 0.001,
    "imbalance_warn_min_samples": 8,
    "imbalance_warn_ratio": 5.0,
    "batch_size": 48,
    "eval_batch_size": 96,
    "dataset_cache_size": 2048,
    "learning_rate": 0.001,
    "hidden_dim": 128,
    "num_layers": 2,
    "dropout": 0.2,
    "num_workers": "auto",
    "pin_memory": "auto",
    "prefetch_factor": 4,
    "persistent_workers": true
  },
  "continual_learning": {
    "enabled": true,
    "resume_from_best": true,
    "cleanup_raw_after_job": true
  },
  "dashboard": {
    "allowed_origins": []
  },
  "pages_sync": {
    "enabled": false,
    "pages_dir": "",
    "project_name": "detectWarning",
    "report_title": "행동 학습 결과 리포트",
    "report_url": "",
    "live_url": "",
    "live_url_env": "DETECTWARNING_LIVE_URL",
    "redirect_delay_seconds": 3,
    "git_auto_push": false,
    "git_commit_prefix": "Update dashboard"
  }
}
